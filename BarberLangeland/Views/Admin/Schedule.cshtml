@model AdminScheduleViewModel
@{
    ViewData["Title"] = "Dagens skema";
    var yesterday = Model.Date.AddDays(-1);
    var tomorrow = Model.Date.AddDays(1);
}

<section class="container section-padding">
    <h1 class="section-title">Dagens skema</h1>

    <form method="get" asp-action="Schedule" class="admin-schedule__date">
        <a class="btn btn-outline-secondary" asp-action="Schedule" asp-route-date="@yesterday.ToString("yyyy-MM-dd")">&larr;</a>
        <input type="date" class="form-control" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" />
        <a class="btn btn-outline-secondary" asp-action="Schedule" asp-route-date="@tomorrow.ToString("yyyy-MM-dd")">&rarr;</a>
        <button class="btn btn-book rounded-pill px-4" type="submit">Vis</button>
    </form>

    <p class="admin-schedule__note">
        En aflyst booking beholder stadig sin plads i kalenderen, så tiden bliver ikke automatisk
        ledig igen. Kontakt kunden direkte, hvis tiden skal frigives.
    </p>

    @if (Model.Groups.Count == 0)
    {
        <p>Der er ingen frisører oprettet.</p>
    }
    else
    {
        foreach (var group in Model.Groups)
        {
            <div class="admin-schedule__barber">
                <h2 class="admin-schedule__barber-name">
                    @group.Barber.Name
                    <span class="admin-schedule__count">@group.Bookings.Count</span>
                </h2>

                @if (group.Bookings.Count == 0)
                {
                    <p class="booking-empty-state">Ingen bookinger denne dag.</p>
                }
                else
                {
                    <table class="admin-schedule__table">
                        <thead>
                            <tr>
                                <th>Tid</th>
                                <th>Kunde</th>
                                <th>Behandling</th>
                                <th>Status</th>
                                <th>Handling</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var booking in group.Bookings)
                        {
                            // A returning customer is never asked for a name, so CustomerName is
                            // often null — and it was populated with the phone number the
                            // customer typed ("65432198"), which is not the same formatting as
                            // the account's stored number ("+4565432198"). Falling back to the
                            // phone number as the *name* therefore rendered it twice on screen:
                            // as the name, and again in the phone span below.
                            //
                            // The name is simply unknown in that case, and the phone span is
                            // the reliable identifier, so say so and let it carry the number
                            // exactly once. A name consisting only of digits and '+' is
                            // treated as a phone number regardless of formatting, which also
                            // covers any older row where the fallback was written differently.
                            var phone = booking.User?.PhoneNumber;
                            var storedName = booking.CustomerName;
                            var looksLikePhone = !string.IsNullOrWhiteSpace(storedName)
                                && storedName.All(c => char.IsDigit(c) || c == '+' || c == ' ');
                            var hasName = !string.IsNullOrWhiteSpace(storedName) && !looksLikePhone;
                            var customerName = hasName ? storedName : "Ukendt navn";
                            var status = booking.IsCancelled ? "Aflyst"
                                : booking.IsNoShow ? "Mødt ikke op"
                                : "Bekræftet";

                            <tr class="@(booking.IsCancelled ? "is-cancelled" : string.Empty)">
                                <td>@booking.BookingTime.ToString(@"HH\:mm")</td>
                                <td>
                                    @customerName
                                    <span class="admin-schedule__phone">@phone</span>
                                </td>
                                <td>@booking.Service?.Name (@((int)booking.Duration.TotalMinutes) min)</td>
                                <td><span class="badge @(booking.IsCancelled ? "text-bg-secondary" : booking.IsNoShow ? "text-bg-warning" : "text-bg-success")">@status</span></td>
                                <td class="admin-schedule__actions">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#editBookingModal"
                                            data-booking-id="@booking.Id"
                                            data-date="@Model.Date.ToString("yyyy-MM-dd")"
                                            data-time="@booking.BookingTime.ToString(@"HH\:mm")"
                                            data-barber-id="@booking.BarberId"
                                            data-service-id="@booking.ServiceId"
                                            disabled="@(booking.IsCancelled || booking.IsNoShow)">Rediger</button>
                                    <form method="post" asp-action="UpdateStatus" class="d-inline">
                                        <input type="hidden" name="id" value="@booking.Id" />
                                        <input type="hidden" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" />
                                        <input type="hidden" name="action" value="noshow" />
                                        <button class="btn btn-sm btn-outline-warning" type="submit" disabled="@booking.IsNoShow">Mødt ikke op</button>
                                    </form>
                                    <form method="post" asp-action="UpdateStatus" class="d-inline">
                                        <input type="hidden" name="id" value="@booking.Id" />
                                        <input type="hidden" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" />
                                        <input type="hidden" name="action" value="cancel" />
                                        <button class="btn btn-sm btn-outline-danger" type="submit" disabled="@booking.IsCancelled">Aflys</button>
                                    </form>
                                    @if (booking.IsCancelled || booking.IsNoShow)
                                    {
                                        <form method="post" asp-action="UpdateStatus" class="d-inline">
                                            <input type="hidden" name="id" value="@booking.Id" />
                                            <input type="hidden" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" />
                                            <input type="hidden" name="action" value="reopen" />
                                            <button class="btn btn-sm btn-outline-primary" type="submit">Gendan</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
            </div>
        }
    }

    @if (TempData["AdminScheduleError"] is string editError && !string.IsNullOrWhiteSpace(editError))
    {
        <div class="alert alert-danger admin-schedule__error" role="alert">@editError</div>
    }
</section>

@if (Model.Barbers.Count > 0)
{
    <div class="modal fade" id="editBookingModal" tabindex="-1" aria-labelledby="editBookingModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form method="post" asp-action="EditBooking">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="editBookingId" />
                    <input type="hidden" name="returnDate" value="@Model.Date.ToString("yyyy-MM-dd")" />

                    <div class="modal-header">
                        <h5 class="modal-title" id="editBookingModalLabel">Rediger booking</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Luk"></button>
                    </div>

                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label" for="editBookingDate">Dato</label>
                            <input type="date" class="form-control" id="editBookingDate" name="date" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="editBookingTime">Tidspunkt</label>
                            <input type="time" class="form-control" id="editBookingTime" name="time" step="1800" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="editBookingBarber">Frisør</label>
                            <select class="form-select" id="editBookingBarber" name="barberId" required>
                                @foreach (var barber in Model.Barbers)
                                {
                                    <option value="@barber.Id">@barber.Name</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="editBookingService">Behandling</label>
                            <select class="form-select" id="editBookingService" name="serviceId" required>
                                @foreach (var service in Model.Services)
                                {
                                    <option value="@service.Id">@service.Name · @service.DurationMinutes min</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuller</button>
                        <button type="submit" class="btn btn-book">Gem ændringer</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        (function () {
            var modal = document.getElementById('editBookingModal');
            if (!modal) return;

            modal.addEventListener('show.bs.modal', function (event) {
                var trigger = event.relatedTarget;
                if (!trigger) return;
                document.getElementById('editBookingId').value = trigger.dataset.bookingId;
                document.getElementById('editBookingDate').value = trigger.dataset.date;
                document.getElementById('editBookingTime').value = trigger.dataset.time;
                document.getElementById('editBookingBarber').value = trigger.dataset.barberId;
                document.getElementById('editBookingService').value = trigger.dataset.serviceId;
            });
        })();
    </script>
}
