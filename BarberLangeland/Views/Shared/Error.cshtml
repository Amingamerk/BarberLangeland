@model ErrorViewModel
@{
    ViewData["Title"] = Model.StatusCode == 404 ? "Siden findes ikke" : "Fejl";
}

<section class="container py-5 text-center">
    @if (Model.StatusCode == 404)
    {
        <h1 class="mb-3">Siden findes ikke</h1>
        <p class="lead">Vi kunne ikke finde den side, du leder efter.</p>
    }
    else
    {
        <h1 class="mb-3">Der opstod en fejl</h1>
        <p class="lead">Noget gik galt. Prøv igen om lidt.</p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn-book rounded-pill px-4 d-inline-block mt-3">Til forsiden</a>

    @if (Model.ShowRequestId)
    {
        <p class="text-muted small mt-4">Fejl-id: <code>@Model.RequestId</code></p>
    }
</section>
