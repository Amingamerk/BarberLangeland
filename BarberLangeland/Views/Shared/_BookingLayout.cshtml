<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Frisør Langeland</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
</head>
<body class="booking-body">
    <header class="booking-header">
        <div class="booking-header__inner">
            <a class="booking-brand" asp-controller="Home" asp-action="Index">
                <img src="~/images/frisør-logo.png" alt="" />
                <span>Frisør Langeland</span>
            </a>
            @* Must point at AccountController.Login, not the scaffolded Identity UI: usernames
               here are opaque "user_<guid>" values, so the Identity page's username lookup
               never matches and no one can sign in through it. Hidden entirely once signed in,
               so an authenticated customer is never invited to log in again. *@
            @if (User?.Identity?.IsAuthenticated != true)
            {
                <a class="booking-login"
                   asp-controller="Account"
                   asp-action="Login"
                   asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString">Login</a>
            }
        </div>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
