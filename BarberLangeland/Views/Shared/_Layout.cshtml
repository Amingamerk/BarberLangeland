<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Frisør Langeland</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
</head>
<body>

  

    <header>
        <nav class="navbar navbar-expand-sm site-navbar">
            <div class="container-fluid d-flex align-items-center justify-content-between">
                @{
                    var isAdmin = User?.IsInRole(BarberLangeland.Services.IdentitySeeder.AdminRole) == true;
                }

                @* An admin runs the shop, not the customer journey, so the customer-facing
                   items (Om os, Priser, Kontakt, Mine bookinger, Book en tid) are replaced by
                   the two views admin actually works in. The logout form is shared between
                   both branches, so it is only written once. *@
                @* Below the large breakpoint the desktop lists are hidden, so the hamburger
                   and the #mobileMenu panel further down carry the same links. *@
                <button class="mobile-toggle d-lg-none" type="button" data-bs-toggle="collapse"
                        data-bs-target="#mobileMenu" aria-controls="mobileMenu" aria-expanded="false"
                        aria-label="Åbn menu">
                    <span class="mobile-toggle__bars" aria-hidden="true"></span>
                </button>

                @if (isAdmin)
                {
                    <ul class="navbar-nav flex-row gap-3 d-none d-lg-flex">
                        <li class="nav-item rounded-pill px-4"><a class="nav-link" asp-controller="Home" asp-action="Index">Forside</a></li>
                        <li class="nav-item rounded-pill px-4"><a class="nav-link" asp-controller="Admin" asp-action="Schedule">Dagens skema</a></li>
                        <li class="nav-item rounded-pill px-4"><a class="nav-link" asp-controller="Barbers" asp-action="Index">Frisører</a></li>
                    </ul>
                }
                else
                {
                    <!-- Venstre: menu (desktop) -->
                    <ul class="navbar-nav flex-row gap-3 d-none d-lg-flex">
                        <li class="nav-item rounded-pill px-4"><a class="nav-link" asp-controller="Home" asp-action="Index">Forside</a></li>
                        <li class="nav-item rounded-pill px-4"><a class="nav-link" asp-controller="Home" asp-action="About">Om os</a></li>
                        <li class="nav-item rounded-pill px-4"><a class="nav-link" asp-controller="Home" asp-action="Prices">Priser</a></li>
                    </ul>
                }

                <!-- Midt: logo -->
                <a class="navbar-brand align-content-center mx-auto" asp-controller="Home" asp-action="Index" title="Frisør Langeland">
                    <img src="~/images/frisør-logo.png" alt="Logo">
                </a>

                <!-- Højre: menu + book-knap -->
                <div class="d-flex align-items-center gap-3">
                    <ul class="navbar-nav flex-row gap-3 d-none d-lg-flex">
                        @if (!isAdmin)
                        {
                            <li class="nav-item rounded-pill px-4"><a class="nav-link" href="#kontakt">Kontakt</a></li>
                        }
                        @if (User?.Identity?.IsAuthenticated == true)
                        {
                            @if (!isAdmin)
                            {
                                <li class="nav-item rounded-pill px-4"><a class="nav-link" asp-controller="Account" asp-action="MyBookings">Mine bookinger</a></li>
                            }
                            <li class="nav-item rounded-pill px-4">
                                @* d-flex h-100 makes the form fill the <li> (which is
                                   stretched to the tallest sibling by the flex row), and
                                   the button keeps the plain .nav-link metrics so it
                                   shares a baseline with the anchor items. Bootstrap's
                                   .btn was previously supplying its own line-height and
                                   padding, which is what pushed the item out of line. *@
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-flex h-100 align-items-center">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="nav-link">Log ud</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item rounded-pill px-4"><a class="nav-link" asp-controller="Account" asp-action="Login">Login</a></li>
                        }
                    </ul>
                    @if (!isAdmin)
                    {
                        <a asp-controller="Booking" asp-action="Index" class="btn-book rounded-pill px-4">Book en tid</a>
                    }
                </div>

                <!-- <partial name="_LoginPartial" />  -->
            </div>

            <div class="collapse mobile-menu d-lg-none" id="mobileMenu">
                <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Forside</a></li>
                    @if (isAdmin)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Schedule">Dagens skema</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Barbers" asp-action="Index">Frisører</a></li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="About">Om os</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Prices">Priser</a></li>
                        <li class="nav-item"><a class="nav-link" href="#kontakt" data-mobile-menu-close>Kontakt</a></li>
                    }
                    @if (User?.Identity?.IsAuthenticated == true)
                    {
                        @if (!isAdmin)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="MyBookings">Mine bookinger</a></li>
                        }
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="nav-link">Log ud</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Login</a></li>
                    }
                </ul>
            </div>
        </nav>
    </header>

    
    <main role="main" class="pb-3">
        @RenderBody()
    </main>

   
    <footer class="footer">
        <div class="container">
            <div class="row">
                <div class="col-md-8">
                    <p>Frisør Langeland</p>
                    <p>CVR: 33341237</p>
                    <p>Tlf: 22 82 97 27</p>
                    <p>Mail: Lai13560@gmail.com</p>
                    <p>Adresse: Østergade 12, 5900 Rudkøbing</p>
                    <p class="text-dark-emphasis">&copy; 2026 - Frisør Langeland.</p>

                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
