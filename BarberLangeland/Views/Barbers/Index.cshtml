@model IEnumerable<BarberLangeland.Models.Barber>

@{
    ViewData["Title"] = "Frisører";
}

<section class="container section-padding admin-barbers">
    <div class="admin-barbers__header">
        <h1 class="section-title">Frisører</h1>
        <a asp-action="Create" class="btn btn-book rounded-pill px-4">Tilføj frisør</a>
    </div>

    @if (!Model.Any())
    {
        <p class="booking-empty-state">Der er ingen frisører oprettet endnu.</p>
    }
    else
    {
        <div class="admin-barbers__grid">
            @foreach (var barber in Model)
            {
                <article class="admin-barbers__card">
                    <div class="admin-barbers__photo">
                        @if (!string.IsNullOrWhiteSpace(barber.ImagePath))
                        {
                            <img src="@barber.ImagePath" alt="@barber.Name" />
                        }
                        else
                        {
                            <span class="admin-barbers__initials">@(barber.Name.Length > 0 ? barber.Name[..1].ToUpperInvariant() : "?")</span>
                        }
                    </div>

                    <div class="admin-barbers__body">
                        <h2 class="admin-barbers__name">@barber.Name</h2>
                        <p class="admin-barbers__title">@barber.Title</p>
                    </div>

                    <div class="admin-barbers__actions">
                        <a asp-action="Edit" asp-route-id="@barber.Id" class="btn btn-sm btn-outline-secondary">Rediger</a>
                        <a asp-action="Delete" asp-route-id="@barber.Id" class="btn btn-sm btn-outline-danger">Slet</a>
                    </div>
                </article>
            }
        </div>
    }
</section>
