@model BarberLangeland.Models.Barber

@{
    ViewData["Title"] = "Tilføj frisør";
}

<section class="container section-padding admin-barbers">
    <h1 class="section-title">Tilføj frisør</h1>

    <form asp-action="Create" class="admin-barbers__form">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Navn</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Title" class="form-label">Titel</label>
            <input asp-for="Title" class="form-control" placeholder="Fx. Seniorfrisør" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ImagePath" class="form-label">Billedsti</label>
            <input asp-for="ImagePath" class="form-control" placeholder="/images/frisor.jpg" />
            <span asp-validation-for="ImagePath" class="text-danger"></span>
            <div class="form-text">Stien skal starte med /images/ og findes i wwwroot/images.</div>
        </div>

        <div class="admin-barbers__form-actions">
            <button type="submit" class="btn btn-book rounded-pill px-4">Opret</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Annuller</a>
        </div>
    </form>
</section>
