@model BarberLangeland.ViewModels.BarberDeleteViewModel

@{
    ViewData["Title"] = "Slet frisør";
}

<section class="container section-padding admin-barbers">
    <h1 class="section-title">Slet @Model.Barber.Name</h1>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="admin-barbers__card admin-barbers__card--confirm">
        <p class="admin-barbers__confirm-text">
            Er du sikker på, at du vil slette <strong>@Model.Barber.Name</strong>
            (@Model.Barber.Title)?
        </p>

        @if (Model.CanDelete)
        {
            <p class="admin-barbers__confirm-hint">Handlingen kan ikke fortrydes.</p>
        }
        else
        {
            <div class="alert alert-warning mb-0" role="alert">
                @Model.Barber.Name har @Model.BookingCount bookinger. Bookings skal slettes eller
                flyttes til en anden frisør, før denne frisør kan fjernes.
            </div>
        }
    </div>

    <div class="admin-barbers__form-actions">
        <form asp-action="Delete" asp-route-id="@Model.Barber.Id" class="d-inline">
            <button type="submit" class="btn btn-outline-danger" disabled="@(!Model.CanDelete)">Slet permanent</button>
        </form>
        <a asp-action="Index" class="btn btn-outline-secondary">Annuller</a>
    </div>
</section>
