@model BookingViewModel

@{
    var step = new BookingStepViewModel
    {
        Number = 1,
        Step = "barber",
        Title = "Vælg frisør",
        Subtitle = "Hvem skal klippe dig?",
        Status = Model.BarberId == 0
            ? "Vælg din frisør"
            : Model.Barbers.FirstOrDefault(barber => barber.Id == Model.BarberId)?.Name ?? string.Empty
    };
}

<section class="booking-step is-active" data-step="1" data-step-name="barber">
    <partial name="_BookingStepHeader" model="step" />
    <div class="booking-step__body" id="@step.PanelId" data-step-body>
    <div class="booking-step__content">
        <div class="booking-option-grid">
        @foreach (var barber in Model.Barbers)
        {
            @await Html.PartialAsync("_OptionCard", new BookingOptionCardViewModel
            {
                Name = nameof(BookingViewModel.BarberId),
                InputId = $"barber-{barber.Id}",
                Value = barber.Id.ToString(),
                Title = barber.Name,
                Meta = string.IsNullOrWhiteSpace(barber.Title) ? null : barber.Title,
                ImagePath = string.IsNullOrWhiteSpace(barber.ImagePath) ? "/images/Frisør-logo.png" : barber.ImagePath,
                Checked = barber.Id == Model.BarberId
            })
        }
    </div>
    <span asp-validation-for="BarberId" class="booking-validation"></span>
    </div>
    </div>
</section>
