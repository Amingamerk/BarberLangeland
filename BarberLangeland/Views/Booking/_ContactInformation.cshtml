@model BookingViewModel

@{
    var step = new BookingStepViewModel
    {
        Number = 4,
        Step = "contact",
        Title = "Kontaktoplysninger",
        Subtitle = "Udfyld dine oplysninger",
        Status = Model.BookingTime == null ? "Vælg tidspunkt for at fortsætte" : "Udfyld dine oplysninger"
    };
}

<section class="booking-step" data-step="4" data-step-name="contact">
    <partial name="_BookingStepHeader" model="step" />
    <div class="booking-step__body" id="@step.PanelId" data-step-body>
    <div class="booking-step__content">
    <fieldset class="booking-contact-grid" data-contact-fields>
        <legend class="visually-hidden">Kontaktoplysninger</legend>
        <partial name="_BookingField" model='new BarberLangeland.ViewModels.BookingFieldViewModel
        {
            Id = "Name",
            Label = "Navn",
            Placeholder = "Dit navn",
            AutoComplete = "name",
            Value = Model.Name
        }' />
        <span asp-validation-for="Name" class="booking-validation"></span>

        <partial name="_BookingField" model='new BarberLangeland.ViewModels.BookingFieldViewModel
        {
            Id = "Email",
            Label = "E-mail",
            Type = "email",
            Placeholder = "din@email.dk",
            AutoComplete = "email",
            Value = Model.Email
        }' />
        <span asp-validation-for="Email" class="booking-validation"></span>

        <partial name="_BookingField" model='new BarberLangeland.ViewModels.BookingFieldViewModel
        {
            Id = "Phone",
            Label = "Telefon",
            Type = "tel",
            Placeholder = "Dit telefonnummer",
            AutoComplete = "tel",
            Value = Model.Phone
        }' />
        <span asp-validation-for="Phone" class="booking-validation"></span>

        <partial name="_BookingField" model='new BarberLangeland.ViewModels.BookingFieldViewModel
        {
            Id = "Password",
            Label = "Adgangskode",
            Type = "password",
            Placeholder = "Din adgangskode",
            AutoComplete = "current-password"
        }' />
        <span asp-validation-for="Password" class="booking-validation"></span>
    </fieldset>

    <button class="booking-button booking-button--primary" type="submit" data-confirm-button>
        Bekræft booking <span aria-hidden="true">→</span>
    </button>
    </div>
    </div>
</section>
