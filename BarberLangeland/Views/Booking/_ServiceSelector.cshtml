@model BookingViewModel

@{
    var step = new BookingStepViewModel
    {
        Number = 2,
        Step = "service",
        Title = "Vælg behandling",
        Subtitle = "Hvad vil du have lavet?",
        Status = Model.ServiceId == 0
            ? (Model.BarberId == 0 ? "Vælg først en frisør" : "Vælg en behandling")
            : Model.Services.FirstOrDefault(service => service.Id == Model.ServiceId)?.Name ?? string.Empty
    };
}

<section class="booking-step" data-step="2" data-step-name="service">
    <partial name="_BookingStepHeader" model="step" />
    <div class="booking-step__body" id="@step.PanelId" data-step-body>
    <div class="booking-step__content">
        <div class="booking-option-grid">
        @foreach (var service in Model.Services)
        {
            @await Html.PartialAsync("_OptionCard", new BookingOptionCardViewModel
            {
                Name = nameof(BookingViewModel.ServiceId),
                InputId = $"service-{service.Id}",
                Value = service.Id.ToString(),
                Title = service.Name,
                Meta = $"{service.DurationMinutes} min · {service.Price:0} kr",
                Description = string.IsNullOrWhiteSpace(service.Description) ? null : service.Description,
                Checked = service.Id == Model.ServiceId
            })
        }
    </div>
    <span asp-validation-for="ServiceId" class="booking-validation"></span>
    </div>
    </div>
</section>
