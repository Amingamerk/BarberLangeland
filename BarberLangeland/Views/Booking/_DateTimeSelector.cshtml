@model BookingViewModel

@{
    var step = new BookingStepViewModel
    {
        Number = 3,
        Step = "datetime",
        Title = "Vælg dato & tid",
        Subtitle = "Find en tid der passer dig",
        Status = Model.BookingTime == null
            ? (Model.ServiceId == 0 ? "Vælg først en behandling" : "Vælg dato og tid")
            : $"{Model.BookingDate:dd.MM.yyyy} · {Model.BookingTime:hh\\:mm}"
    };
}

<section class="booking-step" data-step="3" data-step-name="datetime">
    <partial name="_BookingStepHeader" model="step" />
    <div class="booking-step__body" id="@step.PanelId" data-step-body>
    <div class="booking-step__content">
        <div class="booking-date-time" data-time-selection>
            @* The calendar is the single source of truth for BookingDate. The whole widget
               is rendered client-side once availability for the visible month has been
               fetched; the hidden inputs keep model binding intact. *@
            <div class="booking-date-card" data-booking-availability>
                <p class="booking-empty-state">Vælg en behandling for at se ledige tider.</p>
            </div>
            @* asp-for renders the value in the current culture format, which the client's
               strict parseIso rejects. Emit plain yyyy-MM-dd so a validation-error
               re-render still parses. *@
            <input asp-for="BookingDate" type="hidden"
                   value="@(Model.BookingDate == default ? string.Empty : Model.BookingDate.ToString("yyyy-MM-dd"))" />
            <span asp-validation-for="BookingDate" class="booking-validation"></span>
            <input asp-for="BookingTime" type="hidden" />
            <span asp-validation-for="BookingTime" class="booking-validation"></span>
        </div>
    </div>
    </div>
</section>
